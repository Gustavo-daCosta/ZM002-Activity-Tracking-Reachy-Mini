# --- local environments and caches -------------------------------------------------------------------
reachy_mini_env/
__pycache__/
*.pyc
.DS_Store
*.jpg

# --- model files -------------------------------------------------------------------------------------
# Versioned: the numpy forest exports (wave_classifier*.npz, action_classifier.npz), which the robot runs.
# Ignored: pose-estimation weights (downloaded on demand by core/vision.py) and leftover local artifacts
# (sklearn pickles and crop-sweep models from earlier training runs).
core/models/*.onnx
core/models/*.tflite
core/models/*.task
core/models/*.joblib
core/models/action_classifier_crop*.npz

# --- robot deployment --------------------------------------------------------------------------------
# Pre-downloaded aarch64 wheels for the robot venv, fetched by robot/deploy.sh.
robot/wheels/

# --- datasets ----------------------------------------------------------------------------------------
# 1.8 GB of public skeleton pickles. datasets/SOURCES.md records where each one came from and is tracked;
# fetch the files with tools/download_datasets.sh.
datasets/*.pkl

# --- development record ------------------------------------------------------------------------------
# Design specs, implementation plans and the agent workspace stay local to the machine they were made on.
docs/superpowers/
.superpowers/
